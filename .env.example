# Kaushal Saathi — copy to .env.local and fill in. Never commit .env.local.

# Signs sessions and call tickets. Required: the Next app and the voice server
# must share it, or calls cannot open as a signed-in person. Any long random string.
SESSION_SECRET=

# In production, set so only the Next app can reach the voice server's control plane.
# INTERNAL_TOKEN=

# Demo only: show the OTP on screen instead of sending an SMS.
OTP_DEV=1

# Speech: Hindi STT (saaras:v3) and TTS (bulbul:v3). Required for voice calls.
SARVAM_API_KEY=

# Understanding answers the phrase dictionary cannot place (small model, JSON mode).
GROQ_API_KEY=
# Optional: override the extraction model.
# GROQ_EXTRACT_MODEL=llama-3.1-8b-instant

# Website translation into the 22 Eighth Schedule languages. Bodhan first: its
# keys are per model, so this is a separate key for `indic-translate`
# (console.bodhan.ai) — the Bodhan speech keys are refused.
# BODHAN_TRANSLATE_API_KEY=
# Then SARVAM_API_KEY above if set, then Google Cloud Translation v2:
# GOOGLE_TRANSLATE_API_KEY=

# Optional: real phone calls (IVR) through Twilio — see voice-server/TELEPHONY.md.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+91...
# PUBLIC_VOICE_URL=https://your-voice-server.example.com

# Optional: persistence. Without it everything falls back to .data/*.json.
# MONGODB_URL=mongodb+srv://...
# MONGODB_DB=kaushal_saathi

# Optional, from the original engine: other providers for comparison.
# GOOGLE_API_KEY=
# CARTESIA_API_KEY=
# ELEVENLABS_API_KEY=
# BODHAN_API_KEY=

# Set to "sarvam" to route Bodhan speech (STT/TTS) to Sarvam instead.
# SPEECH_PROVIDER=sarvam
# Bodhan gets this long (ms) before speech falls back to Sarvam automatically.
# BODHAN_FALLBACK_MS=4000
